{
  "name": "obsidian-remote-rest-api",
  "version": "0.1.0",
  "private": true,
  "description": "The Obsidian Local REST API and MCP server, run as a standalone container over a folder of markdown notes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "node --max-old-space-size=6144 node_modules/.bin/tsc -noEmit -skipLibCheck",
    "build-docs": "node scripts/gen-patch-schema.mjs && jsonnet -J docs/src/lib/ -S docs/src/openapi.jsonnet -o docs/openapi.yaml",
    "serve-docs": "npx serve docs",
    "build-toc": "markdown-toc -i README.md",
    "lint": "eslint src/",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "start": "node dist/server.js",
    "docker:build": "docker build -t obsidian-remote-rest-api:dev ."
  },
  "keywords": [
    "obsidian",
    "markdown",
    "rest-api",
    "mcp",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heracraft/obsidian-remote-rest-api.git"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/glob-to-regexp": "^0.4.1",
    "@types/jest": "^29",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^20",
    "@types/node-forge": "^1.0.0",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^2.0.11",
    "better-sse": "^0.16.1",
    "cors": "^2.8.5",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "express": "^4.21.1",
    "glob-to-regexp": "^0.4.1",
    "jest": "^29",
    "json-logic-js": "^2.0.2",
    "markdown-patch": "^1.1.0",
    "markdown-patch-2": "npm:markdown-patch@^2.0.0",
    "markdown-toc": "^1.2.0",
    "marked": "^17.0.6",
    "mime-types": "^2.1.35",
    "node-forge": "^1.2.1",
    "obsidian": "^1.13.1",
    "response-time": "^2.3.2",
    "supertest": "^6.2.2",
    "ts-dedent": "^2.3.0",
    "ts-jest": "^29",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "yaml": "^2.9.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
